DATABASE_URL=sqlite:///./family_tree.db
SECRET_KEY=please-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_TEMPLATE_REGISTER=100001
ALIYUN_SMS_TEMPLATE_LOGIN=100001
ALIYUN_SMS_TEMPLATE_MODIFY_PHONE=100002
ALIYUN_SMS_TEMPLATE_RESET_PASSWORD=100003
ALIYUN_SMS_TEMPLATE_BIND_PHONE=100004
ALIYUN_SMS_TEMPLATE_VERIFY_PHONE=100005
# 私有图片真实文件目录。默认为 backend/data/assets，需持久化备份；不对外静态公开。
ASSET_STORAGE_DIR=
# 关闭仅用于隔离测试/单独 worker；生产默认随 API 进程每 30 秒运行纪念日调度。
NOTIFICATION_SCHEDULER_ENABLED=true
# 可选：浏览器关闭页面后的 Web Push。未配置时只生成收件箱，并明确提示未启用后台推送。
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# 可选：原生 App 的 UniPush 2 服务端凭证。请同时在 DCloud/个推配置厂商/APNs 通道。
UNIPUSH_APP_ID=
UNIPUSH_APP_KEY=
UNIPUSH_MASTER_SECRET=
UNIPUSH_API_BASE=https://restapi.getui.com/v2
# 微信小程序订阅消息。模板字段名需与微信后台申请的模板一致。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_REMINDER_FIELDS={"thing1":"title","date2":"date","thing3":"family"}
